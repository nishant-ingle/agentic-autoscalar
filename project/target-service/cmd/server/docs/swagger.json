                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.HealthResponse"
                        }
                    }
                }
            }
        },
        "/livez": {
            "get": {
                "description": "Returns 200 OK if the server is running.",
