{
    "swagger": "2.0",
    "info": {
        "description": "API for generating synthetic CPU and memory load to test Kubernetes autoscaling.",
        "title": "Agentic Autoscaler Target Workload API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/load/cpu": {
            "get": {
                "description": "Spikes CPU across N goroutines for a specified duration to test autoscaling.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Generate CPU Load",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 500,
                        "description": "Duration of burn in milliseconds (max 30000)",
                        "name": "duration_ms",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Number of worker goroutines (max 16)",
                        "name": "concurrency",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.CPULoadResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Spikes CPU across N goroutines for a specified duration to test autoscaling.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Generate CPU Load",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 500,
                        "description": "Duration of burn in milliseconds (max 30000)",
                        "name": "duration_ms",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Number of worker goroutines (max 16)",
                        "name": "concurrency",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.CPULoadResponse"
                        }
                    }
                }
            }
        },
        "/api/load/memory/allocate": {
            "post": {
                "description": "Artificially inflates the pod's memory working set for autoscaling tests.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Allocate Memory",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 50,
                        "description": "Megabytes to allocate (max 1024)",
                        "name": "mb",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.MemoryLoadResponse"
                        }
                    }
                }
            }
        },
        "/api/load/memory/release": {
            "post": {
                "description": "Clears synthetic memory buffers and forces garbage collection.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Release Memory",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.MemoryLoadResponse"
                        }
                    }
                }
            }
        },
        "/api/workload": {
            "get": {
                "description": "Simulates a standard API call with adjustable I/O sleep delay and CPU hashing.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Simulate Mixed Workload",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 20000,
                        "description": "Number of SHA256 hashing rounds (max 500000)",
                        "name": "rounds",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Simulated I/O sleep delay in ms (max 5000)",
                        "name": "delay_ms",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.WorkloadResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Simulates a standard API call with adjustable I/O sleep delay and CPU hashing.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "load"
                ],
                "summary": "Simulate Mixed Workload",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 20000,
                        "description": "Number of SHA256 hashing rounds (max 500000)",
                        "name": "rounds",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Simulated I/O sleep delay in ms (max 5000)",
                        "name": "delay_ms",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.WorkloadResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns 200 OK if the server is running.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
